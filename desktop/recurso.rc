/*
 * Recursos do "PS JAPA.exe" — o ícone que o Explorer mostra e os dados que
 * aparecem em Propriedades do arquivo.
 *
 * O ícone precisa ser o ID 1: é o de menor número que o Windows encontra, e
 * é esse que ele usa para desenhar o arquivo na pasta e na barra de tarefas.
 *
 * Compilar junto com o programa:
 *   x86_64-w64-mingw32-windres recurso.rc -O coff -o recurso.o
 */

1 ICON "ps-japa.ico"

1 VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    /* 0416 = português do Brasil, 04b0 = Unicode. */
    BLOCK "041604b0"
    BEGIN
      VALUE "ProductName", "PS JAPA"
      VALUE "FileDescription", "Abre o PS JAPA com o perfil no pen drive"
      VALUE "ProductVersion", "1.0.0"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "PS JAPA"
      VALUE "OriginalFilename", "PS JAPA.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x416, 1200
  END
END
